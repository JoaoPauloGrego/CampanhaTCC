<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerenciamento de Itens - Super Admin</title>
  <link rel="icon" href="/logo.png" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">

</head>

<body>
  <div class="container">
    <!-- Header -->
    <header>
      <div class="logo">
        <i class="fas fa-tshirt"></i>
        <h1>Gerenciador de Campanhas</h1>
      </div>

      <div class="user-info">
        <i class="fas fa-user-shield"></i>
        <span>Super Admin</span>
      </div>

      <nav>
        <ul>
          <li><a href="/sAdmin"><i class="fas fa-arrow-left"></i> Voltar</a></li>
          <li><a href="/admin_edit_campanha"><i class="fas fa-tshirt"></i> Gerenciar Campanhas</a></li>
          <li><a href="/logout" class="logout-btn">
              <i class="fas fa-sign-out-alt"></i> Sair
            </a></li>
        </ul>
      </nav>
    </header>

    <div class="main-content">
      <!-- <h2 class="page-title">Gerenciamento de Turmas</h2> -->

      <!-- Mensagens de sucesso/erro -->
      <div class="messages">
        <% if(typeof success !== 'undefined') { %>
        <div class="success-message">
          <i class="fas fa-check-circle"></i> <%= success %>
        </div>
        <% } %>

        <% if(typeof error !== 'undefined') { %>
        <div class="error-message">
          <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
        <% } %>
      </div>

      <!-- Card de Ações -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Ações</h3>
          <button class="btn btn-primary" onclick="openModal('createModal')">
            <i class="fas fa-plus"></i> Novo Item
          </button>
        </div>
        <p>Aqui você pode gerenciar todas os itens do sistema. Crie novos itens, edite os existentes ou desative itens que não estão mais em uso.</p>
      </div>

      <!-- Filtros -->
      <div class="card">
        <h3 class="card-title">Filtros</h3>
        <div class="filters">
          <div class="filter-group">
            <span class="filter-label">Status:</span>
            <select class="filter-select" id="statusFilter" onchange="filterTable()">
              <option value="all">Todos</option>
              <option value="1">Ativos</option>
              <option value="0">Inativos</option>
            </select>
          </div>
          <div class="filter-group">
            <span class="filter-label">Ordenar por:</span>
            <select class="filter-select" id="sortFilter" onchange="filterTable()">
              <option value="nome_turma">Campanha (A-Z)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Card de Listagem de Turmas -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Itens Cadastrados</h3>
          <div>
            <span>Total: <strong><%= typeof itens !== 'undefined' ? itens.length : 0 %> itens</strong></span>
          </div>
        </div>

        <div class="table-responsive">
          <table id="itensTable">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Campanha</th>
                <th>Pontos</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof itens !== 'undefined' && itens.length > 0) { %>
              <% itens.forEach(function(item) { %>
              <tr data-status="<%= item.status %>">
                <td><%= item.id_item %></td>
                <td><%= item.nome_item %></td>
                <td><%= item.id_campanha %></td>
                <td><%= item.pontos %></td>
                <td>
                  <span class="status-badge <%= item.status == 1 ? 'status-active' : 'status-inactive' %>">
                    <%= item.status == 1 ? 'Ativa' : 'Inativa' %>
                  </span>
                </td>
                <td>
                  <button class="btn btn-primary btn-sm" onclick="openEditModal(
                                                '<%= item.nome_item %>', 
                                                '<%= item.id_campanha %>',
                                                '<%= item.pontos %>',
                                                '<%= item.status %>'
                                            )">
                    <i class="fas fa-edit"></i> Editar
                  </button>
                  <% if (item.status == 1) { %>
                  <button class="btn btn-warning btn-sm" onclick="confirmDeactivate('<%= item.id_item %>', '<%= item.nome_item %>')">
                    <i class="fas fa-ban"></i> Desativar
                  </button>
                  <% } else { %>
                  <button class="btn btn-success btn-sm" onclick="confirmActivate('<%= item.id_item %>', '<%= item.nome_item %>')">
                    <i class="fas fa-check"></i> Ativar
                  </button>
                  <% } %>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center;">Nenhum item cadastrado</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <footer>
      <p class="copyright">© 2025 Gerenciador de Campanhas. Todos os direitos reservados.</p>
    </footer>
  </div>

  <!-- Modal para Criar Item -->
  <div id="createModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal('createModal')">&times;</span>
      <h2>Novo Item</h2>
      <form id="createForm" action="/admin_edit_itens/create" method="POST">
        <div class="form-group">
          <label class="form-label" for="nome_item">Nome do Item:</label>
          <input type="text" id="nome_item" name="nome_item" class="form-control" placeholder="Ex: 5º Ano A" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="id_campanha">ID da Campanha:</label>
          <input type="number" id="id_campanha" name="id_campanha" class="form-control" placeholder="Ex: Maria Silva" required>
        </div>
          <div class="form-group">
          <label class="form-label" for="pontos">Pontos:</label>
          <input type="number" id="pontos" name="pontos" class="form-control" placeholder="Ex: Maria Silva" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="status">Status:</label>
          <select id="status" name="status" class="form-control-d" required>
            <option value="1">Ativa</option>
            <option value="0">Inativa</option>
          </select>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> Salvar Item
        </button>
      </form>
    </div>
  </div>

  <!-- Modal para Editar Itens -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal('editModal')">&times;</span>
      <h2>Editar Item</h2>
      <form id="editForm" action="/admin_edit_itens/update" method="POST">
        <input type="hidden" id="edit_id" name="id_item">
        <div class="form-group">
          <label class="form-label" for="edit_nome_item">Nome do Item:</label>
          <input type="text" id="edit_nome_item" name="nome_item" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="admin_edit_campanha">ID da Campanha:</label>
          <input type="number" id="edit_campanha" name="id_campanha" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="edit_pontos">Pontos:</label>
          <input type="number" id="edit_pontos" name="pontos" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="edit_status">Status:</label>
          <select id="edit_status" name="status" class="form-control" required>
            <option value="1">Ativa</option>
            <option value="0">Inativa</option>
          </select>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> Salvar Alterações
        </button>
      </form>
    </div>
  </div>

  <script>
    // Funções para abrir e fechar modais
    function openModal(modalId) {
      document.getElementById(modalId).style.display = 'block';
    }

    function closeModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
    }

    // Fechar modais ao clicar fora deles
    window.onclick = function(event) {
      if (event.target.classList.contains('modal')) {
        event.target.style.display = 'none';
      }
    }

    // Função para abrir modal de edição com dados do item
    function openEditModal(id, id_campanha, nome_item, pontos, status) {
      document.getElementById('edit_nome_item').value = nome_item;
      document.getElementById('edit_campanha').value = id_campanha;
      document.getElementById('edit_pontos').value = pontos;
      document.getElementById('edit_status').value = status;
      openModal('editModal');
    }

    // Função para confirmar desativação de turma
    function confirmDeactivate(id, nome_item) {
      if (confirm(`Tem certeza que deseja desativar o item "${nome_item}"? O item permanecerá no sistema mas não estará disponível para novas campanhas.`)) {
        window.location.href = `/admin_edit_itens/deactivate/${id}`;
      }
    }

    // Função para confirmar ativação de turma
    function confirmActivate(id, nome_item) {
      if (confirm(`Tem certeza que deseja ativar o item "${nome_item}"?`)) {
        window.location.href = `/admin_edit_itens/activate/${id}`;
      }
    }

    // Função para filtrar a tabela
    function filterTable() {
      const statusFilter = document.getElementById('statusFilter').value;
      const sortFilter = document.getElementById('sortFilter').value;
      const table = document.getElementById('turmasTable');
      const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

      // Filtrar por status
      for (let i = 0; i < rows.length; i++) {
        const status = rows[i].getAttribute('data-status');

        if (statusFilter === 'all' || status === statusFilter) {
          rows[i].style.display = '';
        } else {
          rows[i].style.display = 'none';
        }
      }
    }

  </script>
  <style>
    :root {
      --primary: #3498db;
      --secondary: #e74c3c;
      --accent: #f39c12;
      --dark: #2c3e50;
      --light: #ecf0f1;
      --success: #27ae60;
      --warning: #f39c12;
      --danger: #e74c3c;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a2980, #26d0ce);
      color: var(--light);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      margin: 0;
      padding: 0;
    }

    body::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      z-index: -1;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    /* Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo i {
      font-size: 2.5rem;
      color: var(--accent);
    }

    .logo h1 {
      font-size: 1.8rem;
      font-weight: 700;
      color: white;
      margin: 0;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 3rem;
      margin: 0;
      padding: 0;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
      position: relative;
      padding: 5px 0;
    }

    nav a::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s ease;
    }

    nav a:hover::after {
      width: 100%;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.1);
      padding: 8px 15px;
      border-radius: 20px;
    }

    .user-info i {
      font-size: 1.2rem;
    }

    /* Main Content */
    .main-content {
      display: flex;
      flex-direction: column;
      gap: 30px;
      margin-top: -10px;
    }

    .page-title {
      font-size: 2rem;
      color: white;
      margin-bottom: 20px;
      text-align: center;
    }

    .card {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 25px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 1.5rem;
      color: var(--accent);
      margin: 0;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      border: none;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: #2980b9;
      transform: translateY(-2px);
    }

    .btn-success {
      background: #3498db;
      color: white;
    }

    .btn-success:hover {
      background: #362196;
      transform: translateY(-2px);
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    .btn-danger:hover {
      background: #c0392b;
      transform: translateY(-2px);
    }

    .btn-warning {
      background: var(--warning);
      color: white;
    }

    .btn-warning:hover {
      background: #e67e22;
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 0.9rem;
    }

    /* Table Styles */
    .table-responsive {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th,
    td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    th {
      background-color: rgba(0, 0, 0, 0.2);
      font-weight: 600;
    }

    tr:hover {
      background-color: rgba(255, 255, 255, 0.05);
    }

    .status-badge {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .status-active {
      background-color: rgba(0, 55, 255, 0.2);
      color: #bec9ff;
    }

    .status-inactive {
      background-color: rgba(231, 76, 60, 0.2);
      color: #e74c3c;
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      overflow: auto;
    }

    .modal-content {
      background: linear-gradient(135deg, #1a2980, #26d0ce);
      margin: 5% auto;
      padding: 25px;
      border-radius: 15px;
      width: 80%;
      max-width: 600px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      position: relative;
    }

    .close {
      color: #aaa;
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }

    .close:hover {
      color: white;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .form-control {
      width: 90%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(0, 0, 0, 0.2);
      color: white;
      font-size: 1rem;
    }

    .form-control-d{
      width: 94%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(0, 0, 0, 0.2);
      color: white;
      font-size: 1rem;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.3);
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 30px 0;
      margin-top: 50px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logout-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: white;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      margin-top: -4px;
    }

    .logout-btn:hover {
      color: var(--accent);
    }

    /* Filtros */
    .filters {
      display: flex;
      gap: 15px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .filter-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .filter-label {
      font-weight: 600;
    }

    .filter-select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(0, 0, 0, 0.2);
      color: white;
    }

    .filter-select {
      background-color: #1e3a5f;
      /* cor de fundo do select */
      color: white;
      /* cor do texto */
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      opacity: 0;
    }

    /* Responsividade */
    @media (max-width: 768px) {
      .card-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      nav ul {
        flex-direction: column;
        gap: 15px;
      }

      header {
        flex-direction: column;
        gap: 20px;
      }

      .modal-content {
        width: 95%;
        margin: 10% auto;
      }

      .filters {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    .messages {
      margin: 20px 0;
    }

    .success-message {
      background: rgba(46, 204, 113, 0.2);
      color: #fff;
      padding: 15px;
      border-radius: 8px;
      border-left: 4px solid #27ae60;
      margin-bottom: 20px;
    }

    .error-message {
      background: rgba(231, 76, 60, 0.2);
      color: #fff;
      padding: 15px;
      border-radius: 8px;
      border-left: 4px solid #c0392b;
      margin-bottom: 20px;
    }
  </style>
</body>

</html>