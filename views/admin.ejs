<html>

<head>
  <title>Painel Admin</title>
  <link rel="icon" href="/logo.png" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Montserrat:wght@700;800&display=swap"
    rel="stylesheet">
</head>

<body>
  <div class="container">
    <!-- Header -->
    <header>
      <div class="logo">
        <i class="fas fa-tshirt"></i>
        <h1>Gerenciador de Campanhas</h1>
      </div>

      <div class="user-info">
        <i class="fas fa-user-shield"></i>
        <span>Admin: <%= user ? user.nome_usuario : 'Não logado' %> </span>
      </div>

      <nav>
        <ul>
          <li><a href="/"><i class="fas fa-home"></i> Início</a></li>
          <li><a href="/doar"><i class="fas fa-hands-helping"></i> Como Ajudar</a></li>
          <li><a href="/sobre"><i class="fas fa-info-circle"></i> Sobre</a></li>
          <li><a href="/logout" class="logout-btn">
              <i class="fas fa-sign-out-alt"></i> Sair
            </a></li>
        </ul>
      </nav>
    </header>

    <div class="main-content">
      <!-- Formulário de Registro -->
      <div class="form-container">
        <h2 class="form-title">Registrar Nova Doação</h2>

        <div class="messages">
          <% if(typeof success !=='undefined' ) { %>
            <div class="success-message">
              <i class="fas fa-check-circle"></i>
              <%= success %>
            </div>
            <% } %>

              <% if(typeof error !=='undefined' ) { %>
                <div class="error-message">
                  <i class="fas fa-exclamation-circle"></i>
                  <%= error %>
                </div>
                <% } %>
        </div>

        <form action="/doacao" method="POST">

          <div class="form-group">
            <label for="id_campanha"><i class="fas fa-campaign"></i> Campanha:</label>
            <select name="id_campanha" id="id_campanha" required>
              <option value="">Selecione uma campanha</option>
              <% CAMPANHAS.forEach(campanha=> { %>
                <option value="<%= campanha.id_campanha %>">
                  <%= campanha.nome_campanha %> (ID: <%= campanha.id_campanha %>)
                </option>
                <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="id_turma"><i class="fas fa-users"></i> Turma e Docente:</label>
            <select name="id_turma" id="id_turma" required>
              <option value="">Selecione uma turma</option>
              <% TURMAS.forEach(turma=> { %>
                <option value="<%= turma.id_turma %>">
                  <%= turma.nome_turma %> - <%= turma.docente %> (ID: <%= turma.id_turma %>)
                </option>
                <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="id_item"><i class="fas fa-tshirt"></i> Tipo de Item:</label>
            <select name="id_item" id="id_item" required>
              <option value="">Selecione um item</option>
              <% ITENS.forEach(item=> { %>
                <option value="<%= item.id_item %>" data-pontos="<%= item.pontos %>">
                  <%= item.nome_item %> (<%= item.pontos %> pontos)
                </option>
                <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="quantidade"><i class="fas fa-calculator"></i> Quantidade:</label>
            <input type="number" name="quantidade" id="quantidade" min="1" required>
          </div>

          <div class="form-group">
            <label for="data_doacao"><i class="fas fa-calendar-alt"></i> Data:</label>
            <input type="date" name="data_doacao" id="data_doacao" required>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fas fa-save"></i> Registrar Doação
          </button>
        </form>
      </div>

      <!-- Links Rápidos -->
      <div class="info-container">
        <div class="quick-links">
          <a href="/admin/doacoes" class="link-card">
            <i class="fas fa-list"></i>
            <div class="link-text">
              <h3>Ver Todas as Doações</h3>
              <p>Acesse o histórico completo de doações registradas</p>
            </div>
          </a>

          <a href="/admin/turmas" class="link-card">
            <i class="fas fa-chart-bar"></i>
            <div class="link-text">
              <h3>Relatório de Turmas</h3>
              <p>Visualize o ranking e desempenho das turmas</p>
            </div>
          </a>

          <a href="/admin" class="link-card">
            <i class="fas fa-sync-alt"></i>
            <div class="link-text">
              <h3>Recarregar Página</h3>
              <p>Atualize os dados mais recentes</p>
            </div>
          </a>

        </div>

        <div class="stats-card">
          <h3>Dicas Rápidas</h3>
          <ul>
            <li>Verifique a data antes de registrar</li>
            <li>Confira se selecionou a turma correta</li>
            <li>Atualize a página após registrar doações</li>
            <li>Use o relatório para acompanhar o progresso</li>
          </ul>
        </div>
      </div>
    </div>

    <footer>
      <p class="copyright">© 2025 Gerenciador de Campanhas. Todos os direitos reservados.</p>
    </footer>
  </div>

  <script>
    // Definir a data atual como padrão
    document.addEventListener('DOMContentLoaded', function () {
      const today = new Date();
      const formattedDate = today.toISOString().split('T')[0];
      document.getElementById('data_doacao').value = formattedDate;

      // Debug: verificar envio do formulário
      const form = document.querySelector('form');
      form.addEventListener('submit', function (e) {
        console.log('Formulário enviado');
        console.log('Campanha ID:', document.getElementById('id_campanha').value);
        console.log('Turma ID:', document.getElementById('id_turma').value);
        console.log('Item ID:', document.getElementById('id_item').value);
        console.log('Quantidade:', document.getElementById('quantidade').value);
        console.log('Data:', document.getElementById('data_doacao').value);

        // Validação adicional
        const quantidade = document.getElementById('quantidade').value;
        if (quantidade <= 0) {
          e.preventDefault();
          alert('A quantidade deve ser maior que zero');
          return false;
        }
      });
    });

// Função para carregar turmas e itens baseados na campanha selecionada
document.getElementById('id_campanha').addEventListener('change', function() {
  const campanhaId = this.value;
  const turmaSelect = document.getElementById('id_turma');
  const itemSelect = document.getElementById('id_item');
  
  // Limpar opções atuais, mantendo apenas a primeira
  while (turmaSelect.options.length > 1) {
    turmaSelect.remove(1);
  }
  
  while (itemSelect.options.length > 1) {
    itemSelect.remove(1);
  }
  
  if (!campanhaId) {
    // Se nenhuma campanha selecionada, mostrar todas as turmas e todos os itens
    carregarTodasTurmas();
    carregarTodosItens();
    return;
  }
  
  // Fazer requisições paralelas para obter turmas e itens da campanha selecionada
  Promise.all([
    fetch(`/admin/campanha/${campanhaId}/turmas`),
    fetch(`/admin/campanha/${campanhaId}/itens`)
  ])
  .then(responses => Promise.all(responses.map(res => res.json())))
  .then(([turmas, itens]) => {
    // Preencher turmas
    if (turmas.length > 0) {
      turmas.forEach(turma => {
        const option = document.createElement('option');
        option.value = turma.id_turma;
        option.textContent = `${turma.nome_turma} - ${turma.docente} (ID: ${turma.id_turma})`;
        turmaSelect.appendChild(option);
      });
    } else {
      const option = document.createElement('option');
      option.value = "";
      option.textContent = "Nenhuma turma associada a esta campanha";
      option.disabled = true;
      option.selected = true;
      turmaSelect.appendChild(option);
    }
    
    // Preencher itens
    if (itens.length > 0) {
      itens.forEach(item => {
        const option = document.createElement('option');
        option.value = item.id_item;
        option.textContent = `${item.nome_item} (${item.pontos} pontos)`;
        option.setAttribute('data-pontos', item.pontos);
        itemSelect.appendChild(option);
      });
    } else {
      const option = document.createElement('option');
      option.value = "";
      option.textContent = "Nenhum item disponível para esta campanha";
      option.disabled = true;
      option.selected = true;
      itemSelect.appendChild(option);
    }
  })
  .catch(error => {
    console.error('Erro ao carregar turmas ou itens:', error);
    carregarTodasTurmas();
    carregarTodosItens();
  });
});

// Função para carregar todas as turmas (fallback)
function carregarTodasTurmas() {
  fetch('/admin/todas-turmas')
    .then(response => response.json())
    .then(turmas => {
      const turmaSelect = document.getElementById('id_turma');
      turmas.forEach(turma => {
        const option = document.createElement('option');
        option.value = turma.id_turma;
        option.textContent = `${turma.nome_turma} - ${turma.docente} (ID: ${turma.id_turma})`;
        turmaSelect.appendChild(option);
      });
    })
    .catch(error => console.error('Erro ao carregar todas as turmas:', error));
}

// Função para carregar todos os itens (fallback)
function carregarTodosItens() {
  fetch('/admin/todos-itens')
    .then(response => response.json())
    .then(itens => {
      const itemSelect = document.getElementById('id_item');
      itens.forEach(item => {
        const option = document.createElement('option');
        option.value = item.id_item;
        option.textContent = `${item.nome_item} (${item.pontos} pontos)`;
        option.setAttribute('data-pontos', item.pontos);
        itemSelect.appendChild(option);
      });
    })
    .catch(error => console.error('Erro ao carregar todos os itens:', error));
}
  </script>

  <style>
    :root {
      --primary: #3498db;
      --secondary: #e74c3c;
      --accent: #f39c12;
      --dark: #2c3e50;
      --light: #ecf0f1;
      --success: #27ae60;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a2980, #26d0ce);
      color: var(--light);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      margin: 0;
      padding: 0;
    }

    body::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      z-index: -1;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      flex-wrap: wrap;
      gap: 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .logo i {
      font-size: 2.5rem;
      color: var(--accent);
    }

    .logo h1 {
      font-size: 1.8rem;
      font-weight: 700;
      color: white;
      margin: 0;
      white-space: nowrap;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 20px;
      margin: 0;
      padding: 0;
      flex-wrap: wrap;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
      position: relative;
      padding: 5px 0;
      white-space: nowrap;
    }

    nav a::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s ease;
    }

    nav a:hover::after {
      width: 100%;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.1);
      padding: 8px 15px;
      border-radius: 20px;
      flex-shrink: 0;
    }

    .user-info i {
      font-size: 1.2rem;
    }

    /* Main Content */
    .main-content {
      display: flex;
      gap: 40px;
      margin-top: 30px;
      flex: 1;
    }

    .form-container {
      flex: 1;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 30px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      height: fit-content;
    }

    .info-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .form-title {
      font-size: 1.8rem;
      color: var(--accent);
      margin-bottom: 25px;
      text-align: center;
    }

    .form-group {
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 600;
      font-size: 1.1rem;
    }

    select,
    input {
      width: 100%;
      padding: 14px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(0, 0, 0, 0.2);
      color: white;
      font-size: 1rem;
      transition: all 0.3s ease;
      box-sizing: border-box;
    }

    select:focus,
    input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.3);
    }

    option {
      background: #2c3e50;
      color: white;
    }

    .btn-submit {
      background: var(--accent);
      color: white;
      border: none;
      padding: 15px 30px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      width: 100%;
      margin-top: 20px;
      box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
    }

    .btn-submit:hover {
      background: #e67e22;
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(243, 156, 18, 0.6);
    }

    .quick-links {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .link-card {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 20px;
      transition: all 0.3s ease;
      text-decoration: none;
      color: white;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .link-card:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateX(10px);
    }

    .link-card i {
      font-size: 1.8rem;
      color: var(--accent);
    }

    .link-text h3 {
      margin: 0;
      font-size: 1.3rem;
    }

    .link-text p {
      margin: 5px 0 0;
      opacity: 0.8;
    }

    .messages {
      margin: 20px 0;
    }

    .success-message {
      background: rgba(46, 204, 113, 0.2);
      color: #fff;
      padding: 15px;
      border-radius: 8px;
      border-left: 4px solid #27ae60;
      margin-bottom: 20px;
    }

    .error-message {
      background: rgba(231, 76, 60, 0.2);
      color: #fff;
      padding: 15px;
      border-radius: 8px;
      border-left: 4px solid #c0392b;
      margin-bottom: 20px;
    }

    .stats-card {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 20px;
      margin-top: 0;
    }

    .stats-card h3 {
      color: var(--accent);
      margin-top: 0;
    }

    .stats-card ul {
      padding-left: 20px;
      margin: 0;
    }

    .stats-card li {
      margin-bottom: 8px;
    }

    footer {
      text-align: center;
      padding: 30px 0;
      margin-top: 50px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logout-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: white;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      margin-top: -10px;
    }

    .logout-btn:hover {
      color: var(--accent);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      /*pseudo-elemento*/
      /*Isso funciona apenas em navegadores baseados em WebKit/Blink (Chrome, Safari, Edge).
      No Firefox, por exemplo, seria necessário outro ajuste (::-moz-...).*/

      opacity: 0;
    }

    /* Responsividade */
    @media (max-width: 768px) {
      .main-content {
        flex-direction: column;
        gap: 20px;
      }

      header {
        flex-direction: column;
        text-align: center;
        gap: 15px;
      }

      nav ul {
        justify-content: center;
      }

      .container {
        padding: 10px;
      }
    }
  </style>
</body>

</html>